# Burgers Bar staff app — local environment.
# Copy to .env (gitignored) and fill in. Consumed by docker compose, the API,
# and the seed/migrate scripts from this single source (ADR-0010). apps/web reads
# only VITE_API_BASE_URL from apps/web/.env.local, so no server secret is exposed
# into the client bundle.

# --- Postgres (docker compose service `db`) ---
POSTGRES_USER=burgers
POSTGRES_PASSWORD=burgers
POSTGRES_DB=burgers
POSTGRES_PORT=5432

# Connection string the API and migrate/seed scripts use. Host-run apps reach the
# dockerized Postgres over localhost on POSTGRES_PORT.
DATABASE_URL=postgres://burgers:burgers@localhost:5432/burgers

# --- API ---
API_PORT=3000
# Origin the SPA is served from; drives CORS so the cross-origin bearer path is
# exercised in dev (ADR-0010).
CORS_ORIGIN=http://localhost:5173
# Public base URL the app is reached at, used to build invite/reset links.
APP_BASE_URL=http://localhost:5173

# --- Mail (docker compose service `mailpit`; SMTP on 1025, web UI on 8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Burgers Bar <no-reply@burgers.local>"

# --- Auth lifetimes (mechanism fixed in ADR-0006; values in ADR-0010) ---
SESSION_TTL_DAYS=14
INVITE_TTL_HOURS=168
RESET_TTL_HOURS=1

# --- Seed admin (idempotent seed; real values used once in prod — ADR-0005/0010) ---
SEED_ADMIN_EMAIL=admin@burgers.local
SEED_ADMIN_PASSWORD=change-me-locally
