# Burgers Bar staff app — local environment.
# Copy to .env (gitignored) and fill in. Consumed by docker compose, the API,
# and the seed/migrate scripts from this single source (ADR-0010). apps/web reads
# only VITE_API_BASE_URL from apps/web/.env.local, so no server secret is exposed
# into the client bundle.

# --- Postgres (docker compose service `db`) ---
POSTGRES_USER=burgers
POSTGRES_PASSWORD=burgers
POSTGRES_DB=burgers
POSTGRES_PORT=5432

# Connection string the API and migrate/seed scripts use. Host-run apps reach the
# dockerized Postgres over localhost on POSTGRES_PORT.
DATABASE_URL=postgres://burgers:burgers@localhost:5432/burgers

# --- API ---
API_PORT=3000
# Origin the SPA is served from; drives CORS so the cross-origin bearer path is
# exercised in dev (ADR-0010).
CORS_ORIGIN=http://localhost:5173
# Public base URL the app is reached at, used to build invite/reset links.
APP_BASE_URL=http://localhost:5173

# --- Mail (docker compose service `mailpit`; SMTP on 1025, web UI on 8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Burgers Bar <no-reply@burgers.local>"

# --- Assistant: LLM provider (ADR-0013, ADR-0018, ADR-0022) ---
# The Assistant answers through one LLM provider chosen at boot. `openrouter` (default) routes
# through the broker for its multi-vendor model-swap freedom; `gemini` calls Google's
# OpenAI-compatible endpoint directly, which has a genuine free tier (ADR-0018); `groq` calls Groq's
# OpenAI-compatible endpoint, whose free tier gives more request headroom than Gemini's (ADR-0022).
# It is a switch, not a fallback: exactly one provider is live per process, and the SELECTED
# provider's key is REQUIRED and validated at boot — a missing key fails the server fast. The other
# providers' keys may be left blank. (Running locally without using the Assistant still needs a key for the default
# provider; set any non-empty placeholder — its calls just fail as retryable until a real key is set.)
ASSISTANT_PROVIDER=openrouter
# Overrides the routed model; blank uses the provider default (openrouter → google/gemini-2.5-flash,
# gemini → gemini-flash-latest, groq → llama-3.3-70b-versatile). A one-line model swap (ADR-0013).
# On groq, pin llama-3.1-8b-instant here to trade quality for far higher daily request volume.
ASSISTANT_MODEL=
# Required when ASSISTANT_PROVIDER=openrouter. Create one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Required when ASSISTANT_PROVIDER=gemini. Create one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Required when ASSISTANT_PROVIDER=groq (ADR-0022). Create one at https://console.groq.com/keys.
GROQ_API_KEY=

# --- Assistant: Google Drive knowledge corpus (ADR-0004, ADR-0014, ADR-0021) ---
# The Assistant grounds answers on procedures authored in a Google Drive folder the client
# owns, shared read-only to a sync service account and mirrored into the local knowledge_docs
# cache. These two keys are the whole provisioning contract the sync reads; setting them up is
# the out-of-band task in docs/features/assistant/provisioning-runbook.md. Both are REQUIRED:
# the server fails fast at boot if either is absent or malformed (ADR-0021), so a misconfigured
# deploy never runs a permanently empty knowledge base. `make dev` needs a dev service-account key
# and a dev folder for the same reason — boot with the same required configuration as production.
# (The API integration tests are unaffected: they inject a fake Drive port and never load this env.)

# The Drive file id of the shared corpus folder — the trailing path segment of the folder URL
# (drive.google.com/drive/folders/<THIS>). Not a secret, but environment-specific. It must be
# a plain folder shared to the service account, never a Shared Drive (a one-way door forced by
# the client's free plan — ADR-0014). Every Drive read is scoped server-side to this one folder.
DRIVE_FOLDER_ID=

# The sync service account's JSON key, base64-encoded (base64 avoids the newline and quoting
# hazards of the raw JSON's private_key field). A standing secret: in prod a Render secret env
# var, never committed; locally it belongs in .env (gitignored), never here. Generate with:
#   base64 -w0 service-account.json
# On the first run against a populated folder the sync full-loads every document in it (ADR-0021),
# then persists the changes cursor and reconciles incrementally on the ~20-minute interval.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Push notifications (#59) ---
# Both OPTIONAL, unlike the Drive pair above, and deliberately so: until the client's Firebase
# project exists there is nothing to put here, and the feature ships dormant rather than blocking a
# deploy. With either one unset the server registers devices, resolves who a task assignment should
# reach, and sends nothing — so switching notifications on is these two values, not a release.
#
# Firebase Cloud Messaging is the only way to reach an Android phone, and it forwards to Apple's
# APNs for the iOS app once an APNs key is uploaded to the same project, so one credential serves
# both shells. This is a DIFFERENT Google project and a different service account from the Drive
# one above — do not reuse that key.
#
# The Firebase project id (Project settings ▸ General), and the messaging service account's JSON
# key base64-encoded, exactly as the Drive key is:
#   base64 -w0 firebase-service-account.json
# A standing secret in prod (a Render secret env var, never committed); locally it belongs in .env.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Auth lifetimes (mechanism fixed in ADR-0006; values in ADR-0010) ---
SESSION_TTL_DAYS=14
INVITE_TTL_HOURS=168
RESET_TTL_HOURS=1

# --- Password-reset rate limits (story 30) ---
# Reset requests are throttled per email and per IP over one fixed window; a throttled
# request returns the same generic confirmation, so throttling leaks no signal. Tune per
# deploy without a code change. The per-IP limit assumes the API sees the real client IP;
# behind a reverse proxy, configure the proxy/Fastify trustProxy so it does (see notes).
RESET_RATE_LIMIT_PER_EMAIL=5
RESET_RATE_LIMIT_PER_IP=20
RESET_RATE_LIMIT_WINDOW_MINUTES=60

# --- Seed admin (idempotent seed; real values used once in prod — ADR-0005/0010) ---
SEED_ADMIN_EMAIL=admin@burgers.local
SEED_ADMIN_PASSWORD=change-me-locally

# --- WhatsApp daily group digest (ADR-0026) ---
# A standalone daily job in its own container (apps/whatsapp-digest), not a part of the staff app:
# once a day it reads every WhatsApp GROUP chat of the last 24 hours through Green API, has the
# model write ONE Hebrew summary, and sends that one message to ONE number. It shares this file only
# because the repo keeps a single env source (ADR-0010); beyond the keys below it reads nothing from
# here but the ASSISTANT_* provider block above, which it shares with the Assistant rather than
# duplicating — the same provider switch, the same key, one process each.
#
# Two prerequisites that are console and billing decisions rather than code: the instance must be
# authorized by scanning its QR (the message journal only backfills from the moment of
# authorization, so the first digest after one is legitimately near-empty and is not a bug), and the
# instance must be on a PAID Business tier — the free Developer plan allows only 3 chat
# correspondents per month, which a job whose whole premise is reading every group chat exhausts on
# its first run.

# The three Green API credentials are REQUIRED, exactly as the Drive pair above is: the job fails
# fast at boot if any is absent, so a misconfigured container never limps along scanning nothing
# while looking healthy. All three ride in the URL PATH — Green API takes no Authorization header —
# which is why the client never logs a request URL and never puts a response body in an error.

# The per-instance API host, copied from the instance's page in the Green API console. Older
# instances answer on https://api.green-api.com, newer ones on a sharded host such as
# https://7103.api.greenapi.com; hardcoding either one 403s or 404s against the other, so this is
# configuration, never a constant.
GREEN_API_URL=
# The instance id from the same page. It is glued straight onto the literal path prefix
# `waInstance` with no separator; a wrong value comes back as HTTP 403 Forbidden, not 401.
GREEN_API_ID_INSTANCE=
# The instance's API token, and an unusual standing secret: it is the LAST PATH SEGMENT of every
# request URL, which makes any logged URL a credential leak. Never committed; locally it belongs in
# .env (gitignored), in prod in the VPS's root-only /docker/burgers-bar/.env.prod. A wrong value
# comes back as HTTP 401 Unauthorized.
GREEN_API_TOKEN_INSTANCE=

# OPTIONAL, unlike the three above, and left blank deliberately, the way the Firebase pair is: this
# is the one number the daily digest is sent to. With it blank the job still checks the gateway,
# scans every group chat, builds the transcript, writes the Hebrew summary and reports it — and
# sends nothing. So switching sending on is this one value, not a release, and a blank recipient is
# a normal, successful run rather than a misconfiguration.
#
# A non-blank value is digits only, in full international format: +972-50-123-4567 is 972501234567.
# No plus, no national leading zero, no spaces or dashes — the job builds the chatId as
# <digits>@c.us, and a malformed number fails the boot instead of quietly delivering elsewhere.
WHATSAPP_DIGEST_RECIPIENT=
# Which group chats the digest may read, as a comma-separated list of Green API chat ids
# (120363422645974630@g.us,120363423889893000@g.us). BLANK MEANS EVERY GROUP the linked account is
# in, which is what a dedicated production number wants and what a PERSONAL phone must never do:
# the journals return every group that account belongs to, so a personal number linked for testing
# would feed its owner's work, community and family groups through a model and into the digest.
# Set this whenever the linked account is somebody's own phone. Ids, not names — a member can
# rename a group, which would silently widen or empty an allowlist keyed on names.
WHATSAPP_DIGEST_GROUPS=
# The Asia/Jerusalem local hour (0-23) the long-running container sends at. Local rather than UTC,
# and compared as a wall-clock hour rather than by offset arithmetic, so Israel's two DST changeover
# days — one 23 hours long, one 25 — each still fire exactly once. Ignored by `npm run digest:once`,
# which runs immediately and exits.
DIGEST_FIRE_HOUR=8
# Where the "already fired today" marker is kept, so a restart cannot resend a digest that has
# already gone out. The default suits local use and `npm run digest:once` never reads it at all; in
# prod docker-compose.prod.yml overrides this to a path on a named volume, because a marker in the
# container's own writable layer would reset on every deploy.
DIGEST_STATE_FILE=.digest-state.json
