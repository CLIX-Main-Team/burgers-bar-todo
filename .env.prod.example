# Production environment for the Hostinger VPS (2026-08 move) — the contract
# docker-compose.prod.yml reads. Copy to .env.prod ON THE VPS beside the compose file
# (root-only, chmod 600) and fill in from the local .env's migration sections. Never
# committed; this example carries no secrets.
#
# NOT here, on purpose: CORS_ORIGIN and APP_BASE_URL are derived from DEPLOY_HOST in
# the compose file so the origin can never disagree with the route Traefik serves;
# NODE_ENV is pinned there too. PORT is not needed — the API defaults to 3000 and only
# Traefik talks to it.

# The public hostname Traefik routes and gets certificates for. The interim value until
# the client's domain arrives; changing it (plus a web rebuild, since the SPA bakes its
# origin) IS the domain cutover.
DEPLOY_HOST=burgers.srv1928986.hstgr.cloud

# --- Database: the owner's Supabase session pooler, UNCHANGED by this move (outbound).
# Keep sslmode=no-verify (node-postgres rejects the pooler chain under require).
DATABASE_URL=

# --- Assistant (same values that lived on Render) ---
ASSISTANT_PROVIDER=openrouter
ASSISTANT_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Drive knowledge corpus — both REQUIRED at boot ---
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Mail over Gmail (SMTP verified open from this VPS 2026-08-27) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Burgers Bar <clixteam579@gmail.com>"

# --- Push (optional; unset = dormant no-op sender, same as on Render) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Behind Traefik, resolve the real client IP from X-Forwarded-For; safe here
# because the API publishes no host port and the proxy is the only way in.
TRUST_PROXY=true

# --- Seed admin (used once; already seeded in this database) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- WhatsApp daily digest (ADR-0026) — its own container, no inbound surface ---
# All three GREEN_API_* are REQUIRED at boot. Add them here BY HAND before the merge lands: the
# container fails fast without them and then crashloops under restart: unless-stopped, and the
# deploy will not notice (its health wait inspects burgers-bar-api-1 only). GREEN_API_URL is
# per-instance (older: https://api.green-api.com, newer: https://7103.api.greenapi.com) — copy it
# from the console. The token is the LAST PATH SEGMENT of every request URL, not a header.
GREEN_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Blank on purpose, as the push pair above is: the job checks the gateway, scans every group chat,
# and writes the Hebrew summary every run — and sends nothing. Turning sending on is this one
# value, not a release. Digits only, full international format: 972501234567, no +, no leading 0.
WHATSAPP_DIGEST_RECIPIENT=
# The group chats the digest may read, comma-separated Green API chat ids; blank means every group
# the linked account is in. Blank is correct only while that account is a dedicated line sitting in
# branch groups and nothing else — the moment the QR is scanned by a phone somebody also uses
# personally, every group on it is in scope, so fill this in instead.
WHATSAPP_DIGEST_GROUPS=
# The Asia/Jerusalem local hour the scheduled container sends at; --once ignores it. The digest
# reads the ASSISTANT_* block above through its own schema — one provider serves both containers.
DIGEST_FIRE_HOUR=8
# DIGEST_STATE_FILE is NOT set here: docker-compose.prod.yml sets it in the service, and a
# compose `environment:` value wins over `env_file`, so a value put here would be ignored. It
# points at a named volume so a deploy or a crash cannot resend a digest that already went out.
